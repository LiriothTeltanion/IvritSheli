# Ivrit Sheli Ultimate — local configuration
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DATA_DIR=./data
APP_DB_PATH=./data/ivrit_sheli.db
DICTIONARY_DB_PATH=./data/hebrew_dictionary.db
AI_PROVIDER=offline
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
DICTA_NAKDAN_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_ACCESS_TOKEN=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8765/oauth/callback
LOG_LEVEL=INFO
ALLOW_CLOUD_PROCESSING=false
DEBUG=false
