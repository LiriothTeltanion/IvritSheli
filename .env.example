# Ivrit Sheli 2.3 — copy to .env for local use; never commit real secrets.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# Optional manual-development overrides. Leave these commented when using the
# Windows launcher so it stores private learning data under %LOCALAPPDATA%,
# outside this OneDrive-synced source tree.
# APP_DATA_DIR=./data
# APP_DB_PATH=./data/ivrit_sheli.db
# DICTIONARY_DB_PATH=./data/hebrew_dictionary.db
# Cloud runtime only: must authenticate directly as the restricted ivrit_sheli_runtime role.
DATABASE_URL=
# Deployment/pre-deploy only: privileged migration/provisioning connection.
# The application entrypoint removes this variable before starting Uvicorn.
MIGRATION_DATABASE_URL=

# Cloud authentication. SESSION_SECRET must be at least 32 random characters.
AUTH_REQUIRED=false
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_NAME=ivrit_session
SESSION_TTL_SECONDS=604800
SESSION_RETENTION_SECONDS=604800
DEMO_SESSION_LIMIT=64
USER_SESSION_LIMIT=8
# Direct mode keys clients from the raw ASGI peer. Railway mode is production-only and
# assumes Railway ingress overwrites one valid X-Real-IP with no direct public bypass.
# X-Forwarded-For is never trusted. RAILWAY_ENVIRONMENT_ID is injected by Railway.
TRUSTED_PROXY_MODE=direct
RAILWAY_ENVIRONMENT_ID=
OAUTH_STATE_LIMIT=1024
AUTH_CLIENT_RATE_LIMIT_REQUESTS=20
AUTH_GLOBAL_RATE_LIMIT_REQUESTS=1000
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_CLIENT_KEYS=10000
AUTHENTICATED_WRITE_RATE_LIMIT_REQUESTS=120
AUTHENTICATED_WRITE_RATE_LIMIT_WINDOW_SECONDS=60
AUTHENTICATED_WRITE_RATE_LIMIT_MAX_USERS=10000
MAX_CLOUD_SNAPSHOT_BYTES=4194304
# Default body cap plus multipart envelope caps for the smaller 5/25 MB file limits.
MAX_REQUEST_BODY_BYTES=1048576
MAX_ICS_UPLOAD_BODY_BYTES=6291456
MAX_AUDIO_UPLOAD_BODY_BYTES=27262976
PUBLIC_BASE_URL=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://127.0.0.1:5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/github/callback
# Beginner-facing Google sign-in. These credentials are separate from the
# optional Google Workspace connector below and request only `openid profile`.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback

# Observability and immutable build identity.
LOG_LEVEL=INFO
BUILD_COMMIT=development

# Optional AI features. Offline mode remains fully functional.
AI_PROVIDER=offline
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Legacy/default provider voice retained for compatibility.
OPENAI_TTS_VOICE=coral
# Server-controlled mappings for the learner-facing synthetic voice styles.
OPENAI_TTS_VOICE_MASCULINE=onyx
OPENAI_TTS_VOICE_FEMININE=coral
DICTA_NAKDAN_URL=
ALLOW_CLOUD_PROCESSING=false
# Production cloud AI remains blocked unless the signed-in provider identity matches.
CLOUD_AI_ALLOWED_GITHUB_LOGINS=
CLOUD_AI_ALLOWED_GITHUB_IDS=
CLOUD_AI_ALLOWED_GOOGLE_SUBJECTS=

# Optional read-only Google connectors.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_ACCESS_TOKEN=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8765/oauth/callback
# Production Google previews remain blocked unless the signed-in identity matches.
GOOGLE_CONNECTORS_ALLOWED_GITHUB_LOGINS=
GOOGLE_CONNECTORS_ALLOWED_GITHUB_IDS=
GOOGLE_CONNECTORS_ALLOWED_GOOGLE_SUBJECTS=
DEBUG=false
